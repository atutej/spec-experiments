 from marinskyrl.runtime_options import WeightSyncTransport
 
 
+def _memdiag(tag: str) -> None:
+    """MEMDIAG (2026-11-06): driver view vs PyTorch view of this GPU, to locate memory held outside the allocator."""
+    try:
+        if not torch.cuda.is_available():
+            return
+        free, total = torch.cuda.mem_get_info()
+        gib = 1024.0**3
+        used = (total - free) / gib
+        alloc = torch.cuda.memory_allocated() / gib
+        resv = torch.cuda.memory_reserved() / gib
+        peak = torch.cuda.max_memory_allocated() / gib
+        logger.info(
+            f"MEMDIAG rank={torch.distributed.get_rank() if torch.distributed.is_initialized() else -1} "
+            f"{tag}: driver_used={used:.1f} GiB pytorch_alloc={alloc:.1f} reserved={resv:.1f} "
+            f"peak_alloc={peak:.1f} outside_pytorch={used - resv:.1f} GiB"
+        )
+    except Exception as exc:  # diagnostics must never break training
+        logger.warning(f"MEMDIAG failed at {tag}: {exc}")
+
+
