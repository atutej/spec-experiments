+    temperature: 1.0
+    top_p: 1.0
+    top_k: -1
+
+  engine_init_kwargs:
+    enable_return_routed_experts: false
+    served_model_name: snowball-67b-a2b-sft-s3-nemotron-terminal-step1888
+
+  # PR #550 (marinskyrl.speculative_decoding.SpeculativeDecodingConfig) -- unlike the
+  # static-only smoke test, this exercises the real online DraftTrainer update path.
+  # entrypoint above MUST be main_base (parse_speculative_decoding_config rejects
+  # .training under any other entrypoint, e.g. terminal_bench).
+  speculative_decoding:
+    method: eagle3
+    model:
+      source_uri: hf://laion/snowball-64k-eagle3-draft-r2egym
+      source_identity: 4bdb47c08e5b5190bea3c7a93c3e14470230e469
+    num_speculative_tokens: 3
+    training:
+      # Update after this one step so the smoke test actually exercises a real
+      # online draft update, not just static serving.
+      interval_steps: 1
+      # Matches Russell's reference config (cloud/iris/configs/snowball_megatron_online_eagle.yaml),
+      # which shares our max_new_tokens_per_turn=8192 -- max_window_tokens=16384 is 2x that cap,
+      # giving headroom for one full-length response plus its prompt context in a single window.
+      # 4096 was silently discarding every response longer than 4096 tokens as "oversized" in
+      # merge_online_eagle_captures, which is most of them now that lowering temperature (1.2->1.0)
+      # gives us properly long, coherent step-by-step reasoning instead of short garbled output.
+      max_tokens_per_update: 131072
+      max_window_tokens: 16384
+      max_tokens_per_micro_batch: 8192
+      max_sequences_per_prompt_group: 2
+      # min_train_sequences=6/min_holdout_sequences=3 (Russell's reference) is a floor of 9 --
+      # unreachable for us regardless of window-size fixes, since our ceiling is
+      # max_sequences_per_prompt_group(2) x 4 prompt groups (train_batch_size=4) = 8 windows max.
+      # Unlike the token/window-size settings above, this floor doesn't scale with response length,
+      # it scales with batch size -- so it stays at our own smoke-test floor, not Russell's.
+      min_train_sequences: 1
+      holdout_fraction: 0.25
+      min_holdout_sequences: 1
+      epochs_per_update: 1
+      learning_rate: 5.0e-5
+      max_validation_loss_increase: 0.05
+      max_validation_agreement_decrease: 0.01
+      reserved_gpu_memory_gib: 12
