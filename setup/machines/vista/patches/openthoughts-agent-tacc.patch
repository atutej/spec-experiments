+# Vista GB200 (`gb` partition) — same physical cluster/hostname pattern as `vista` (GH200,
+# `gh` partition), but 4x GB200 per node instead of 1x GH200. Hostname alone can't
+# disambiguate the two (both match r".*?.vista.tacc.utexas.edu"), so detect_hpc() below
+# checks $SLURM_JOB_PARTITION after a vista-pattern hostname match and returns this object
+# instead when the partition is "gb". Account/dotenv/paths are identical to `vista` (same
+# user, same $SCRATCH); only the GPU topology differs, so those are inherited rather than
+# duplicated. The GH200-specific node_exclusion_list/nccl_settings tuning on `vista` was
+# learned from real GH200 node failures and does not carry over -- left empty here pending
+# real GB200-specific observations.
+vista_gb200 = HPC(
+    name="vista_gb200",
+    hostname_pattern=r".*?.vista.tacc.utexas.edu",
+    dotenv_filename="tacc.env",
+    account="CCR24067",
+    partition="gb",
+    gpus_per_node=4,
+    cpus_per_node=144,
+    internet_node=True,
+    gpus_type="GB200 189GB",
+    unified_gpu_memory=True,
+    total_partition_nodes=18,
+    pretok_time_limit="4:00:00",
+    pretok_partition="gb",
+    needs_cuda_detection=True,
+    # Runtime configuration for Ray/vLLM. gcc/15.1.0 (not the default nvc/nvc++) is
+    # load-bearing here too -- same aarch64-armv9-flag rejection issue as GH200.
+    modules=["gcc/15.1.0", "tacc-apptainer"],
+    conda_activate="source $SCRATCH/miniconda3/etc/profile.d/conda.sh && conda activate $SCRATCH/miniconda3/envs/vllm_sandboxes",
+    env_vars={
+        "HF_HOME": "/tmp/hf_home",
+        "PYTHONFAULTHANDLER": "1",
+        "NCCL_TIMEOUT": "1800",
+        "NCCL_IB_TIMEOUT": "22",
+        "PYTORCH_ALLOC_CONF": "garbage_collection_threshold:0.6,max_split_size_mb:128",
+    },
+    library_paths={
+        "TRITON_CC": "/home1/apps/gcc/15.1.0/bin/gcc",
+        "LD_PRELOAD": "/home1/apps/gcc/15.1.0/lib64/libstdc++.so.6",
+        "CC": "/home1/apps/gcc/15.1.0/bin/gcc",
+        "CXX": "/home1/apps/gcc/15.1.0/bin/g++",
+    },
+    training_launcher="torchrun",
+    default_time_limit="24:00:00",
+    max_time_limit="48:00:00",
+    num_nodes_slow=1,
+    num_nodes_default=1,
+    num_nodes_fast=4,
+)
+
 # EmpireAI Beta — NY-state consortium GB200 NVL72 SuperPOD (aarch64 Grace + B200/sm_100).
 # Placed by the aarch64/TACC blocks (vista) since it shares that arch class.
 # Containerized via Pyxis/Enroot (mega_final_dm.sqsh). Integrated into hpc.launch —
@@ -1889,11 +1938,15 @@ clusters = [
     jupiter,
     juwels,
     leonardo,
+    # vista MUST be checked before capella: capella's hostname_pattern (r"c\d") is broad
+    # enough to match Vista GB200 compute-node hostnames too (e.g. "c672-016...vista.tacc...
+    # .edu"), and detect_hpc() returns on first match. Local-only reorder, not an upstream fix.
+    vista,
+    vista_gb200,
     capella,
     alpha,
     dip,
     lrz,
-    vista,
     empireai,
     lonestar,
     claix,
@@ -1918,10 +1971,18 @@ def detect_hpc() -> HPC:
     if nersc_host == "perlmutter":
         candidate_hostnames.add(f"{hostname}.perlmutter.nersc.gov")
 
+    # Vista's `gh` (GH200, 1 GPU/node) and `gb` (GB200, 4 GPU/node) partitions share the
+    # same hostname pattern, so hostname alone can't tell them apart. Both `vista` and
+    # `vista_gb200` match; disambiguate by $SLURM_JOB_PARTITION (reliably set inside any
+    # sbatch/srun/idev allocation) before falling through to the first hostname match.
+    slurm_partition = os.environ.get("SLURM_JOB_PARTITION", "")
+
     for cluster in clusters:
         pattern = re.compile(cluster.hostname_pattern)
         for candidate in candidate_hostnames:
             if pattern.match(candidate):
+                if cluster.name in ("vista", "vista_gb200") and slurm_partition:
+                    cluster = vista_gb200 if slurm_partition == "gb" else vista
                 print(f"Automatically detected HPC: {cluster.name}")
                 return cluster.model_copy(update={"hostname": candidate})
 
